<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F6F7FB">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="#FFFFFF">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="‹"
            android:textSize="30sp"
            android:textColor="#1800FF"
            android:backgroundTint="#F0EDFF"
            android:contentDescription="Go back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Study Quest"
                android:textColor="#20243A"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Learn together. Grow together."
                android:textColor="#777F99"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Subjects Heading -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:text="My Subjects"
        android:textColor="#20243A"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Subject Selection -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMath"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Animation"
                android:textAllCaps="false"
                android:backgroundTint="#1800FF"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnScience"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="CLED"
                android:textAllCaps="false"
                android:backgroundTint="#FFFFFF"
                android:textColor="#1800FF" />

            <Button
                android:id="@+id/btnEnglish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Media literacy"
                android:textAllCaps="false"
                android:backgroundTint="#FFFFFF"
                android:textColor="#1800FF" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Discussion Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="10dp"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="3dp">

        <!-- Discussion Title -->
        <TextView
            android:id="@+id/txtSubjectTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Animation Discussion"
            android:textColor="#1800FF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Welcome Message -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="#F0EDFF">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STUDY QUEST"
                android:textColor="#1800FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Hello Nice, Welcome to Study Quest!"
                android:textColor="#20243A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Feel free to ask questions and share your ideas about this subject."
                android:textColor="#777F99"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Comments Heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="8dp"
            android:text="Comments"
            android:textColor="#20243A"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Scrollable Comments -->
        <ScrollView
            android:id="@+id/commentsScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/commentsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Example Comment -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="Nice: Welcome everyone!"
                    android:textColor="#20243A"
                    android:textSize="14sp"
                    android:background="#F2F3F8" />

            </LinearLayout>

        </ScrollView>

        <!-- Comment Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="10dp"
            android:background="#FFFFFF">

            <EditText
                android:id="@+id/inputComment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Write a comment..."
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:minHeight="48dp"
                android:padding="12dp"
                android:textSize="14sp"
                android:background="#F2F3F8" />

            <Button
                android:id="@+id/btnSend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Send"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1800FF" />

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <Button
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="⌂\nHome"
            android:textAllCaps="false"
            android:textSize="11sp"
            android:textColor="#777F99"
            android:backgroundTint="#FFFFFF" />

        <Button
            android:id="@+id/navSubjects"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="▤\nSubjects"
            android:textAllCaps="false"
            android:textSize="11sp"
            android:textColor="#1800FF"
            android:backgroundTint="#FFFFFF" />

        <Button
            android:id="@+id/navMessages"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="✉\nMessages"
            android:textAllCaps="false"
            android:textSize="11sp"
            android:textColor="#777F99"
            android:backgroundTint="#FFFFFF" />

        <Button
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="☺\nProfile"
            android:textAllCaps="false"
            android:textSize="11sp"
            android:textColor="#777F99"
            android:backgroundTint="#FFFFFF" />

    </LinearLayout>

</LinearLayout>