<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudyQuest">

        <activity
            android:name="com.example.jhedrickamoguispeta2.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.example.jhedrickamoguispeta2.AccountCreationActivity"
            android:exported="false" />

        <activity
            android:name="com.example.jhedrickamoguispeta2.ManageTaskActivity"
            android:exported="false" />

        <activity
            android:name="com.example.jhedrickamoguispeta2.MainActivity"
            android:exported="false" />

        <activity
            android:name="com.example.studyquest.comment2ndscreen"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
